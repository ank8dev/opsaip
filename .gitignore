# Dependencies
node_modules/

# Build output
dist/
/apps/desktop/release/
*.tsbuildinfo

# Server data (SQLite). Anchored: a bare "data/" would also hide apps/web/src/data/
/server/data/

# Environment (keep .env.example)
.env
.env.*
!.env.example

# Logs
npm-debug.log*
*.log

# OS and editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Python caches from brand/ scripts
__pycache__/
*.pyc
